# ML Platform Environment variables. Copy this file to .env and adjust values as needed

# Application Settings
DEBUG=true
ENVIRONMENT=development

# MLflow Settings (MLFLOW__ prefix maps to MLflowSettings in config.py)
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow
MLFLOW__TRACKING_URI=http://localhost:5001
MLFLOW__ARTIFACT_ROOT=/mlflow/artifacts

# Data Settings (DATA__ prefix maps to DataSettings in config.py)
DATA__ROOT=data

# Airflow Settings
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
