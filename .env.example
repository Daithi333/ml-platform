# ML Platform Environment variables — Docker Compose values.
# Copy this file to .env and adjust as needed.
# Service hostnames are Docker network names (not localhost).

# Application Settings
DEBUG=true
ENVIRONMENT=development

# MLflow (MLFLOW__ prefix maps to MLflowSettings in config.py)
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflow
MLFLOW__TRACKING_URI=http://mlflow-server:5000
MLFLOW__ARTIFACT_ROOT=/mlflow/artifacts

# Data (DATA__ prefix maps to DataSettings in config.py)
DATA__ROOT=data

# Notifications (optional — omit to disable)
# NOTIFICATIONS__SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Airflow Settings
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=true
AIRFLOW_POSTGRES_USER=airflow
AIRFLOW_POSTGRES_PASSWORD=airflow
